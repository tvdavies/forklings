{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "forklings",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "routes": [{ "pattern": "forklings.dev", "custom_domain": true }],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/auth/*", "/mcp"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "PLAYER", "class_name": "PlayerDO" },
      { "name": "BATTLE", "class_name": "BattleDO" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["PlayerDO", "BattleDO"] }],
  "d1_databases": [
    { "binding": "DB", "database_name": "forklings-db", "database_id": "16108f11-44aa-4c37-8743-619bfb0dc5b0", "migrations_dir": "migrations" }
  ],
  "vars": { "PUBLIC_ORIGIN": "https://forklings.dev", "DEMO_LOGIN": "on", "NPCS": "on" },
  // House NPCs: seeding, care and their battles run on this schedule.
  "triggers": { "crons": ["*/20 * * * *"] },
  "observability": { "enabled": true }
}
